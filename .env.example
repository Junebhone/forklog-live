# --- App (safe to ship; Expo inlines EXPO_PUBLIC_*) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=agent_...        # Conversational AI agent (public agent, no auth, for demo)

# --- Edge Functions only: `supabase secrets set KEY=value` (never in the app) ---
GEMINI_API_KEY=AIza...                         # https://aistudio.google.com/apikey
GEMINI_EXTRACT_MODEL=gemini-3.1-pro-preview
GEMINI_COACH_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash   # extract-recipe tries these in order on quota, overload, or timeout
EXTRACT_BUDGET_MS=140000                          # stay under the Edge Function wall-clock limit (150 s on the free plan)
ELEVENLABS_API_KEY=xi_...
ELEVENLABS_VOICE_ID=...
STUB_MODE=0                                       # 1 = every function returns its sample.json (build screens before keys exist)
